/// Customer master (200).
table Customers
	lineageTag: c5529c14-f210-406e-9e68-04eded98dbc0

	column customer_id
		dataType: string
		isHidden
		isKey
		lineageTag: eaabe198-0963-40de-aebf-2983e40d522e
		sourceColumn: customer_id

	column customer_name
		dataType: string
		lineageTag: 518888f7-6bda-4517-bdd2-c9f3c180ea93
		sourceColumn: customer_name

	column email
		dataType: string
		isHidden
		lineageTag: 092f8d20-97f0-4567-9a94-faa4960bfeec
		sourceColumn: email

	column signup_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 0b2263af-a6ef-4d25-a8f1-c22f86735177
		sourceColumn: signup_date

	column loyalty_tier
		dataType: string
		lineageTag: 6678b86e-4497-4259-b23e-49a7cf9c889c
		sourceColumn: loyalty_tier

	partition Customers = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "customers.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"email"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"customer_id", type text}, {"customer_name", type text}, {"email", type text}, {"signup_date", type date}, {"loyalty_tier", type text}}, "en-US")
				in
				    Typed

